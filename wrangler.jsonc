{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezevillo-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "services": [
    { "binding": "IBIT", "service": "ezevillo-ibit-to-btc" },
    { "binding": "GIT_REVIEW", "service": "ezevillo-git-review-workflow" },
    { "binding": "TRUCO", "service": "ezevillo-truco-a-3" }
  ],
  "env": {
    "preview": {
      "name": "ezevillo-portfolio-preview",
      "workers_dev": true,
      "routes": [],
      "services": [
        { "binding": "IBIT", "service": "ezevillo-ibit-to-btc" },
        { "binding": "GIT_REVIEW", "service": "ezevillo-git-review-workflow" },
        { "binding": "TRUCO", "service": "ezevillo-truco-a-3" }
      ]
    }
  }
}

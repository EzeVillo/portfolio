{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezevillo-portfolio",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "env": {
    "preview": {
      "name": "ezevillo-portfolio-preview",
      "workers_dev": true,
      "routes": []
    }
  },
  "routes": [
    {
      "pattern": "ezevillo.com",
      "custom_domain": true
    }
  ]
}
